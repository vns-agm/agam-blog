# Turso database URL, e.g. libsql://my-blog-yourname.turso.io
# Leave as file:local.db to develop against a local SQLite file.
TURSO_DATABASE_URL=file:local.db
# Turso auth token (from `turso db tokens create <db-name>`). Not needed for file: URLs.
TURSO_AUTH_TOKEN=
# Password for the /admin area
ADMIN_PASSWORD=change-me
